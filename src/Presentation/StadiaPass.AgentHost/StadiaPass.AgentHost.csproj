<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The hosting and DevUI packages are preview; they reference each other with exact preview
         versions, and NU1608/NU1902-style pinning noise from that is not this project's fault. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The guardrail is scored on its own, without a model in the way: what it removes and, just
         as importantly, what it leaves alone. -->
    <InternalsVisibleTo Include="StadiaPass.AgentHost.UnitTests" />

    <!-- And scored again with a model in the way: the evals put the real guardrail in front of the
         real model, so what they measure is the pipeline production runs and not a plainer one. -->
    <InternalsVisibleTo Include="StadiaPass.AgentHost.Evals" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\orchestrator\StadiaPass.ServiceDefaults\StadiaPass.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.DevUI" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

</Project>
