@{
    ViewData["Title"] = "Privacy";
}

<span class="sp-eyebrow">Privacy</span>
<h1 class="sp-title mb-4">What StadiaPass keeps</h1>

<div class="sp-card p-4" style="max-width: 68ch;">
    <p class="sp-note mb-3">
        Your account details are held in the identity provider, not in this application. StadiaPass stores the
        tickets issued to you: the match, the seat, the price paid and the access code.
    </p>
    <p class="sp-note mb-0">
        Card details are passed straight to the payment provider for the single charge you authorise. They are
        never written to the StadiaPass database.
    </p>
</div>
