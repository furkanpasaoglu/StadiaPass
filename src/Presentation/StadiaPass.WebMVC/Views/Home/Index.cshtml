@{
    ViewData["Title"] = "How it works";
}

<div class="sp-marquee">
    <span class="sp-eyebrow">StadiaPass box office</span>
    <h1 class="sp-title sp-title--lead">One seat, one holder,<br />no double sale.</h1>
    <p class="sp-note mt-3" style="color: rgba(255,255,255,.62); max-width: 52ch;">
        Pick a seat on the map and it is taken off the market while you pay for it. Every ticket is a seat
        nobody else can be sold.
    </p>
    <div class="mt-4">
        <a class="btn btn-primary" asp-area="" asp-controller="Matches" asp-action="Index">See upcoming matches</a>
    </div>
</div>

<div class="row g-3">
    @{
        var steps = new[]
        {
            ("01", "Pick a seat", "The map shows every seat in the venue. Free seats are the empty ones; the hatched seats are being paid for by someone else right now."),
            ("02", "It is held for 10 minutes", "The moment you click, that seat leaves the market. The countdown on your stub tells you how long you have; when it runs out the seat goes back."),
            ("03", "Pay and get the code", "The ticket arrives with an access code under My tickets. That code is what the turnstile reads.")
        };
    }
    @foreach (var (number, heading, body) in steps)
    {
        <div class="col-md-4">
            <div class="sp-card h-100 p-4">
                <span class="sp-eyebrow">Step @number</span>
                <h2 class="h5 mb-2">@heading</h2>
                <p class="sp-note">@body</p>
            </div>
        </div>
    }
</div>
