@using StadiaPass.WebMVC.Models
@model MatchListViewModel
@{
    ViewData["Title"] = "Matches";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Upcoming matches</h1>
</div>

@await Html.PartialAsync("_Alerts")

<ul class="nav nav-pills mb-4">
    <li class="nav-item">
        <a class="nav-link @(Model.SelectedCategory is null ? "active" : "")" asp-action="Index">All</a>
    </li>
    @foreach (var category in Model.Categories)
    {
        <li class="nav-item">
            <a class="nav-link @(string.Equals(Model.SelectedCategory, category, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               asp-action="Index" asp-route-category="@category">@category</a>
        </li>
    }
</ul>

@if (Model.Matches.Count is 0)
{
    <div class="alert alert-info">No matches in this category yet.</div>
}
else
{
    <div class="row g-3">
        @foreach (var match in Model.Matches)
        {
            var sold = match.Capacity is 0 ? 0 : (int)Math.Round(100m * match.SoldSeatCount / match.Capacity);
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary">@match.Category</span>
                            <span class="badge bg-secondary">@match.Status</span>
                        </div>
                        <h5 class="card-title mb-1">@match.HomeTeam <small class="text-muted">vs</small> @match.AwayTeam</h5>
                        <p class="card-text text-muted mb-2">
                            @match.VenueName<br/>
                            @match.KickOffUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </p>
                        <div class="progress mb-2" style="height: 6px;">
                            <div class="progress-bar bg-dark" role="progressbar" style="width: @sold%"></div>
                        </div>
                        <small class="text-muted">
                            @match.AvailableSeatCount available &middot; @match.ReservedSeatCount held &middot; @match.SoldSeatCount sold
                        </small>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a class="btn btn-sm btn-primary w-100" asp-action="SeatSelection" asp-route-id="@match.Id">
                            Choose a seat
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
