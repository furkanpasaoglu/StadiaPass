@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="sp-empty">
    <span class="sp-eyebrow">Error</span>
    <h2>The request did not complete</h2>
    <p>
        Nothing on this page was saved. Go back to the matches list and try again — a seat already held for
        you stays yours until its hold runs out.
    </p>
    <a class="btn btn-primary" asp-area="" asp-controller="Matches" asp-action="Index">Back to matches</a>

    @if (Model.ShowRequestId)
    {
        <p class="sp-note mx-auto mt-4 mb-0">
            Quote this reference when you report it: <code>@Model.RequestId</code>
        </p>
    }
</div>
