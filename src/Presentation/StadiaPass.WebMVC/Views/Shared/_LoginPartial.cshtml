@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@if (User.Identity?.IsAuthenticated == true)
{
    <ul class="navbar-nav align-items-center">
        <li class="nav-item">
            <span class="nav-link text-dark">
                <span class="badge rounded-pill bg-primary me-1">@(User.Identity.Name?[..1].ToUpperInvariant())</span>
                @User.Identity.Name
            </span>
        </li>
        <li class="nav-item">
            <form method="post" asp-area="" asp-controller="Account" asp-action="Logout" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary">Log out</button>
            </form>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav align-items-center gap-2">
        <li class="nav-item">
            <a class="btn btn-sm btn-outline-primary"
               asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">Log in</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-sm btn-primary"
               asp-area="" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@returnUrl">Register</a>
        </li>
    </ul>
}
