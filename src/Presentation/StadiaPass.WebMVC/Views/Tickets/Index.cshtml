@using StadiaPass.WebMVC.Models
@model IReadOnlyList<TicketSummary>
@{
    ViewData["Title"] = "My tickets";
}

<h1 class="h4 mb-3">My tickets</h1>

@await Html.PartialAsync("_Alerts")

@if (Model.Count is 0)
{
    <div class="alert alert-info">You have not bought any tickets yet.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Access code</th>
                <th>Seat</th>
                <th>Price</th>
                <th>Issued</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td><code>@ticket.AccessCode</code></td>
                <td>@ticket.SeatNumber</td>
                <td>@ticket.Price.ToString("N2") @ticket.Currency</td>
                <td>@ticket.IssuedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td><span class="badge bg-dark">@ticket.Status</span></td>
            </tr>
        }
        </tbody>
    </table>
}
