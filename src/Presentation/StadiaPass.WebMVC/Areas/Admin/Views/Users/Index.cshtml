@model UserPortalViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Users</h1>
        <div class="text-muted small">Accounts live in Keycloak; the portal brokers every change through the API.</div>
    </div>
    <a class="btn btn-primary" asp-action="Create">New user</a>
</div>

@await Html.PartialAsync("_Alerts")

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input class="form-control" name="search" value="@Model.Search" placeholder="Search username or email"/>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

@if (Model.Users.Count is 0)
{
    <div class="alert alert-info">No users matched.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Username</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            var currentRole = user.Roles.FirstOrDefault();
            <tr>
                <td><code>@user.Username</code></td>
                <td>@($"{user.FirstName} {user.LastName}".Trim())</td>
                <td>@(user.Email ?? "-")</td>
                <td style="min-width: 16rem;">
                    <form method="post" asp-action="UpdateRole" class="d-flex gap-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.Id"/>
                        <select name="role" class="form-select form-select-sm">
                            <option value="">(no role)</option>
                            @foreach (var role in Model.AssignableRoles)
                            {
                                <option value="@role" selected="@(string.Equals(role, currentRole, StringComparison.Ordinal))">@role</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                    </form>
                </td>
                <td>
                    <span class="badge @(user.Enabled ? "bg-success" : "bg-secondary")">
                        @(user.Enabled ? "Enabled" : "Disabled")
                    </span>
                </td>
                <td class="text-end">
                    <form method="post" asp-action="ToggleEnabled" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.Id"/>
                        <input type="hidden" name="email" value="@user.Email"/>
                        <input type="hidden" name="firstName" value="@user.FirstName"/>
                        <input type="hidden" name="lastName" value="@user.LastName"/>
                        <input type="hidden" name="enabled" value="@((!user.Enabled).ToString().ToLowerInvariant())"/>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(user.Enabled ? "Disable" : "Enable")
                        </button>
                    </form>
                    <form method="post" asp-action="Delete" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.Id"/>
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
