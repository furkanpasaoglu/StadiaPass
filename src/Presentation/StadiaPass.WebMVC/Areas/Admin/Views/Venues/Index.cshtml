@model VenueListViewModel
@{
    ViewData["Title"] = "Venues";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Venues</h1>
        <div class="text-muted small">
            A match materialises its seat map from the plan defined here, so a plan cannot be reshaped once a
            match uses it.
        </div>
    </div>
    @if (User.HasPermission(StadiaPassPermissions.Venues.Create))
    {
        <a class="btn btn-primary" asp-action="Create">New venue</a>
    }
</div>

@await Html.PartialAsync("_Alerts")

@if (Model.Venues.Count is 0)
{
    <div class="alert alert-info">No venues defined yet.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>City</th>
                <th>Kind</th>
                <th>Blocks</th>
                <th>Capacity</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var venue in Model.Venues)
        {
            <tr>
                <td><strong>@venue.Name</strong></td>
                <td>@venue.City</td>
                <td><span class="badge bg-secondary">@venue.Kind</span></td>
                <td>
                    @foreach (var block in venue.Blocks)
                    {
                        <span class="badge bg-light text-dark border me-1">
                            @block.Name @block.RowCount&times;@block.SeatsPerRow
                            @if (block.PriceMultiplier != 1m)
                            {
                                <span class="text-primary">&times;@block.PriceMultiplier.ToString("0.##")</span>
                            }
                        </span>
                    }
                </td>
                <td>@venue.Capacity</td>
                <td class="text-end">
                    @if (User.HasPermission(StadiaPassPermissions.Venues.Update))
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@venue.Id">Edit</a>
                    }
                    @if (User.HasPermission(StadiaPassPermissions.Venues.Delete))
                    {
                        <form method="post" asp-action="Delete" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@venue.Id"/>
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
