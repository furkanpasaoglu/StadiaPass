@model CategoryListViewModel
@{
    ViewData["Title"] = "Sport categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Sport categories</h1>
        <div class="text-muted small">A category decides which kinds of venue its matches can be opened in.</div>
    </div>
    @if (User.HasPermission(StadiaPassPermissions.Categories.Create))
    {
        <a class="btn btn-primary" asp-action="Create">New category</a>
    }
</div>

@await Html.PartialAsync("_Alerts")

@if (Model.Categories.Count is 0)
{
    <div class="alert alert-info">No categories defined yet.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Playable in</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var category in Model.Categories)
        {
            <tr>
                <td><strong>@category.Name</strong></td>
                <td class="text-muted">@(category.Description ?? "-")</td>
                <td>
                    @foreach (var kind in category.AllowedVenueKinds)
                    {
                        <span class="badge bg-secondary">@kind</span>
                    }
                </td>
                <td>
                    <span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">
                        @(category.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasPermission(StadiaPassPermissions.Categories.Update))
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">Edit</a>
                    }
                    @if (User.HasPermission(StadiaPassPermissions.Categories.Delete))
                    {
                        <form method="post" asp-action="Delete" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@category.Id"/>
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
