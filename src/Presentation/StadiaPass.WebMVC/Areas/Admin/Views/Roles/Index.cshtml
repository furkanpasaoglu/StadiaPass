@model RoleEditorViewModel
@{
    ViewData["Title"] = "Roles and permissions";
}

<div class="sp-head">
    <div>
        <span class="sp-eyebrow">Back office</span>
        <h1 class="sp-title">Roles &amp; permissions</h1>
        <p class="sp-note mt-2">
            Roles live in Keycloak. A role grants a set of permissions; a token issued to its members carries
            every one of them.
        </p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New role</a>
</div>

@await Html.PartialAsync("_Alerts")

<div class="row g-3">
    <div class="col-lg-4">
        <div class="list-group">
            @if (Model.Roles.Count is 0)
            {
                <div class="list-group-item sp-note">No business roles defined yet.</div>
            }
            @foreach (var role in Model.Roles)
            {
                var active = Model.Selected is not null
                             && string.Equals(Model.Selected.Name, role.Name, StringComparison.Ordinal);
                <a class="list-group-item list-group-item-action @(active ? "active" : "")"
                   asp-action="Index" asp-route-role="@role.Name">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <strong>@role.Name</strong>
                        <span class="sp-mono small">@role.Permissions.Count</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(role.Description))
                    {
                        <div class="small @(active ? "" : "sp-note")">@role.Description</div>
                    }
                </a>
            }
        </div>
    </div>

    <div class="col-lg-8">
        @if (Model.Selected is null)
        {
            <div class="sp-empty">
                <span class="sp-eyebrow">Nothing selected</span>
                <h2>Pick a role to edit</h2>
                <p>Choose a role on the left and its permissions open here, grouped by the area they cover.</p>
            </div>
        }
        else
        {
            <form method="post" asp-action="UpdatePermissions">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RoleName" value="@Model.Selected.Name"/>

                <div class="sp-card">
                    <div class="sp-block__head">
                        <h2 class="sp-block__name mb-0">@Model.Selected.Name</h2>
                        <span class="sp-block__count">@Model.Selected.Permissions.Count granted</span>
                    </div>
                    <div class="p-3">
                        @foreach (var group in Model.PermissionCatalogue)
                        {
                            var groupId = $"group-{group.Name}";
                            <div class="mb-3">
                                <div class="form-check border-bottom pb-1 mb-2">
                                    <input class="form-check-input permission-group" type="checkbox"
                                           id="@groupId" data-group="@group.Name"/>
                                    <label class="form-check-label fw-semibold" for="@groupId">@group.Name</label>
                                </div>
                                <div class="ps-4 row row-cols-1 row-cols-md-2 g-1">
                                    @foreach (var permission in group.Permissions)
                                    {
                                        var granted = Model.Selected.Permissions.Contains(permission, StringComparer.Ordinal);
                                        var id = permission.Replace('.', '-');
                                        <div class="col">
                                            <div class="form-check">
                                                <input class="form-check-input permission-item" type="checkbox"
                                                       name="Permissions" value="@permission" id="@id"
                                                       data-group="@group.Name" checked="@granted"/>
                                                <label class="form-check-label small" for="@id">
                                                    @permission[(permission.LastIndexOf('.') + 1)..]
                                                    <span class="sp-mono">@permission</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">Save permissions</button>
                    </div>
                </div>
            </form>

            <form method="post" asp-action="Delete" class="mt-3"
                  data-confirm="Delete the role @Model.Selected.Name? Anyone holding it loses these permissions.">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleName" value="@Model.Selected.Name"/>
                <button type="submit" class="btn btn-outline-danger btn-sm">Delete role</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.permission-group').forEach(function (header) {
            var group = header.dataset.group;
            var items = document.querySelectorAll('.permission-item[data-group="' + group + '"]');

            function sync() {
                var checked = Array.prototype.filter.call(items, function (item) { return item.checked; }).length;
                header.checked = checked === items.length && items.length > 0;
                header.indeterminate = checked > 0 && checked < items.length;
            }

            header.addEventListener('change', function () {
                items.forEach(function (item) { item.checked = header.checked; });
                sync();
            });

            items.forEach(function (item) { item.addEventListener('change', sync); });
            sync();
        });
    </script>
}
