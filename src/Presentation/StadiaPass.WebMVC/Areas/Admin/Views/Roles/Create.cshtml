@model CreateRoleInput
@{
    ViewData["Title"] = "New role";
    var catalogue = (IReadOnlyList<PermissionGroupSummary>)ViewBag.PermissionCatalogue;
}

<div class="sp-head">
    <div>
        <span class="sp-eyebrow">Back office &middot; roles</span>
        <h1 class="sp-title">New role</h1>
        <p class="sp-note mt-2">The role is created in Keycloak and the ticked permissions are bound to it.</p>
    </div>
</div>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="sp-card p-4 mb-3" style="max-width: 54rem;">
        <div class="row">
            <div class="col-md mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="BoxOffice"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control"/>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="sp-card mb-3">
        <div class="sp-block__head">
            <h2 class="sp-block__name mb-0">Permissions</h2>
        </div>
        <div class="p-3">
            @foreach (var group in catalogue)
            {
                <div class="mb-3">
                    <div class="border-bottom pb-1 mb-2 fw-semibold">@group.Name</div>
                    <div class="ps-3 row row-cols-1 row-cols-md-3 g-1">
                        @foreach (var permission in group.Permissions)
                        {
                            var id = permission.Replace('.', '-');
                            var granted = Model.Permissions.Contains(permission, StringComparer.Ordinal);
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Permissions"
                                           value="@permission" id="@id" checked="@granted"/>
                                    <label class="form-check-label small" for="@id">
                                        @permission[(permission.LastIndexOf('.') + 1)..]
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 align-items-center">
        <button type="submit" class="btn btn-primary">Create role</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
