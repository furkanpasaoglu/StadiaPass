<Project Sdk="Microsoft.NET.Sdk">

  <!-- No project references on purpose. The evals go over HTTP to a running agent host, because what is
       being measured is what a member of staff gets: retrieval through the MCP server, the guardrail, the
       prompt and the model, as production runs them. A reference to the host would make it possible to
       score a plainer pipeline than the one that ships. -->

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GoldenPolicyQuestions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
