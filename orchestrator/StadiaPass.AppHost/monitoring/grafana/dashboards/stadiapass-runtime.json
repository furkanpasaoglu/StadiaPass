{
  "uid": "stadiapass-runtime",
  "title": "StadiaPass runtime",
  "description": "ASP.NET Core and .NET runtime metrics scraped from the OpenTelemetry endpoint published by StadiaPass.ServiceDefaults.",
  "tags": ["stadiapass", "dotnet", "opentelemetry"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
        "query": "label_values(http_server_active_requests, service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape targets up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"stadiapass.*\"})",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service=~\"$service\"}[1m]))",
          "legendFormat": "rps"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "p95 request duration",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "5xx / sec",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service=~\"$service\",http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "HTTP requests by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, http_response_status_code) (rate(http_server_request_duration_seconds_count{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Request duration by route (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (http_route, le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Memory: working set and GC heap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "dotnet_process_memory_working_set_bytes{service=~\"$service\"}",
          "legendFormat": "{{service}} working set"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (dotnet_gc_last_collection_heap_size_bytes{service=~\"$service\"})",
          "legendFormat": "{{service}} GC heap"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Allocation rate and GC pauses",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(dotnet_gc_heap_total_allocated_bytes_total{service=~\"$service\"}[1m])",
          "legendFormat": "{{service}} allocated/s"
        },
        {
          "refId": "B",
          "expr": "rate(dotnet_gc_pause_time_seconds_total{service=~\"$service\"}[1m])",
          "legendFormat": "{{service}} GC pause/s"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "CPU time and thread pool",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(dotnet_process_cpu_time_seconds_total{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}} cpu cores"
        },
        {
          "refId": "B",
          "expr": "dotnet_thread_pool_thread_count_total{service=~\"$service\"}",
          "legendFormat": "{{service}} threads"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Exceptions and lock contention",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(dotnet_exceptions_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}} exceptions/s"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (rate(dotnet_monitor_lock_contentions_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}} contentions/s"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL command duration (p95) and pool",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_client_operation_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p95 command"
        },
        {
          "refId": "B",
          "expr": "sum(db_client_connection_count{service=~\"$service\"})",
          "legendFormat": "connections"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Waiting to be sent",
      "description": "Written and not yet handed over: outbox rows the broker has not taken, and provider events the inbox has not put on the bus. A spike is ordinary. A number that climbs and stays up is a sweeper that cannot keep up, or one that cannot reach RabbitMQ.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(stadiapass_outbox_pending{service=~\"$service\"})",
          "legendFormat": "outbox"
        },
        {
          "refId": "B",
          "expr": "sum(stadiapass_inbox_pending{service=~\"$service\"})",
          "legendFormat": "inbox"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Given up on",
      "description": "Messages the sweepers have stopped retrying. Nothing will pick these up again: above zero means a confirmation nobody received or a chargeback nobody acted on, and it is waiting for a person. This is what the provisioned alert fires on.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(stadiapass_outbox_dead{service=~\"$service\"})",
          "legendFormat": "outbox"
        },
        {
          "refId": "B",
          "expr": "sum(stadiapass_inbox_dead{service=~\"$service\"})",
          "legendFormat": "inbox"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Outbox and inbox depth",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(stadiapass_outbox_pending{service=~\"$service\"})",
          "legendFormat": "outbox pending"
        },
        {
          "refId": "B",
          "expr": "sum(stadiapass_inbox_pending{service=~\"$service\"})",
          "legendFormat": "inbox pending"
        },
        {
          "refId": "C",
          "expr": "sum(stadiapass_outbox_dead{service=~\"$service\"})",
          "legendFormat": "outbox dead"
        },
        {
          "refId": "D",
          "expr": "sum(stadiapass_inbox_dead{service=~\"$service\"})",
          "legendFormat": "inbox dead"
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*dead" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Searches answered by the index",
      "description": "Share of searches the cluster actually answered. Below 100% the rest were handed the plain listing with a banner saying so - the site still sells tickets, but nobody can find a fixture by name.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(stadiapass_search_duration_seconds_count{service=~\"$service\",outcome=\"answered\"}[5m])) / clamp_min(sum(rate(stadiapass_search_duration_seconds_count{service=~\"$service\"}[5m])), 0.0000001)",
          "legendFormat": "answered"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "noValue": "no searches",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Search latency and fallbacks",
      "description": "The visitor's two-second budget is the ceiling: a search that has not come back by then is abandoned and the listing is shown instead, which is what the unreachable line counts.",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stadiapass_search_duration_seconds_bucket{service=~\"$service\",outcome=\"answered\"}[5m])))",
          "legendFormat": "p95 answered"
        },
        {
          "refId": "B",
          "expr": "sum(rate(stadiapass_search_duration_seconds_count{service=~\"$service\",outcome=\"unavailable\"}[5m]))",
          "legendFormat": "unreachable/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95 answered" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "unreachable/s" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Search index against the database",
      "description": "Two counts of the same thing. They should sit on top of each other; a gap is the projection behind, and the index flat at zero while the database is not is an index somebody dropped - every search still succeeds and finds nothing.",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "stadiapass-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(stadiapass_search_indexable_matches{service=~\"$service\"})",
          "legendFormat": "database says"
        },
        {
          "refId": "B",
          "expr": "sum(stadiapass_search_indexed_matches{service=~\"$service\"})",
          "legendFormat": "index holds"
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "custom": { "fillOpacity": 0, "showPoints": "never", "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "index holds" },
            "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }]
          }
        ]
      }
    }
  ]
}
