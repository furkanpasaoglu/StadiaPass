{
  "realm": "stadiapass",
  "displayName": "StadiaPass",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "StadiaPass.Tickets", "description": "Ticket module" },
      { "name": "StadiaPass.Tickets.View", "description": "Read tickets" },
      { "name": "StadiaPass.Tickets.Create", "description": "Issue a ticket for a seat" },
      { "name": "StadiaPass.Tickets.Reserve", "description": "Reserve an available ticket" },
      { "name": "StadiaPass.Tickets.Sell", "description": "Confirm the sale of a reserved ticket" },
      { "name": "StadiaPass.Tickets.Cancel", "description": "Cancel a ticket" },
      { "name": "StadiaPass.Matches", "description": "Match module" },
      { "name": "StadiaPass.Matches.View", "description": "Read matches" },
      { "name": "StadiaPass.Matches.Create", "description": "Schedule a match" },
      { "name": "StadiaPass.Matches.Postpone", "description": "Postpone a match" }
    ]
  },
  "clients": [
    {
      "clientId": "stadiapass-api",
      "name": "StadiaPass API",
      "description": "Resource server. Validates tokens, never initiates a flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "stadiapass-scalar",
      "name": "StadiaPass Scalar reference",
      "description": "Public client used by the Scalar OpenAPI UI (authorization code + PKCE).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5042/*",
        "https://localhost:7147/*"
      ],
      "webOrigins": [
        "http://localhost:5042",
        "https://localhost:7147"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "stadiapass-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "stadiapass-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "stadiapass-mvc",
      "name": "StadiaPass MVC",
      "description": "Confidential client for the Razor front end (authorization code). Direct access grants are enabled for local endpoint testing only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "stadiapass-mvc-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost:7064/*",
        "http://localhost:5230/*"
      ],
      "webOrigins": [
        "https://localhost:7064",
        "http://localhost:5230"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "stadiapass-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "stadiapass-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "mudur",
      "firstName": "Merve",
      "lastName": "Mudur",
      "email": "mudur@stadiapass.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "mudur", "temporary": false }
      ],
      "realmRoles": [
        "StadiaPass.Tickets.View",
        "StadiaPass.Tickets.Create",
        "StadiaPass.Tickets.Reserve",
        "StadiaPass.Tickets.Sell",
        "StadiaPass.Tickets.Cancel",
        "StadiaPass.Matches.View",
        "StadiaPass.Matches.Create",
        "StadiaPass.Matches.Postpone"
      ]
    },
    {
      "username": "gise",
      "firstName": "Gokhan",
      "lastName": "Gise",
      "email": "gise@stadiapass.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "gise", "temporary": false }
      ],
      "realmRoles": [
        "StadiaPass.Tickets.View",
        "StadiaPass.Tickets.Create",
        "StadiaPass.Tickets.Reserve",
        "StadiaPass.Tickets.Sell",
        "StadiaPass.Matches.View"
      ]
    },
    {
      "username": "seyirci",
      "firstName": "Selim",
      "lastName": "Seyirci",
      "email": "seyirci@stadiapass.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "seyirci", "temporary": false }
      ],
      "realmRoles": [
        "StadiaPass.Tickets.View",
        "StadiaPass.Matches.View"
      ]
    }
  ]
}
