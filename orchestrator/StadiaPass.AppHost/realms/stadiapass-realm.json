{
  "realm": "stadiapass",
  "displayName": "StadiaPass",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "StadiaPass.Venues",
        "description": "Venue module"
      },
      {
        "name": "StadiaPass.Venues.View",
        "description": "Read venues and their seating plans"
      },
      {
        "name": "StadiaPass.Venues.Create",
        "description": "Define a venue seating plan"
      },
      {
        "name": "StadiaPass.Matches",
        "description": "Match module"
      },
      {
        "name": "StadiaPass.Matches.View",
        "description": "Browse matches and seat maps"
      },
      {
        "name": "StadiaPass.Matches.Create",
        "description": "Create a match and materialise its seats"
      },
      {
        "name": "StadiaPass.Matches.Cancel",
        "description": "Call a match off and refund every ticket sold for it"
      },
      {
        "name": "StadiaPass.Analytics",
        "description": "Analytics module"
      },
      {
        "name": "StadiaPass.Analytics.ViewRevenue",
        "description": "Read what a fixture has taken: tickets sold, refunds, net revenue and occupancy"
      },
      {
        "name": "StadiaPass.Tickets",
        "description": "Ticket module"
      },
      {
        "name": "StadiaPass.Tickets.View",
        "description": "Read own tickets"
      },
      {
        "name": "StadiaPass.Tickets.Reserve",
        "description": "Hold a seat on the seat map"
      },
      {
        "name": "StadiaPass.Tickets.Purchase",
        "description": "Turn a held seat into a ticket"
      },
      {
        "name": "StadiaPass.Tickets.Cancel",
        "description": "Cancel an issued ticket"
      },
      {
        "name": "StadiaPass.Tickets.ViewAll",
        "description": "Read any ticket, including one issued to another customer"
      },
      {
        "name": "StadiaPass.Roles",
        "description": "Role module"
      },
      {
        "name": "StadiaPass.Roles.View",
        "description": "Read business roles"
      },
      {
        "name": "StadiaPass.Roles.Create",
        "description": "Create a business role"
      },
      {
        "name": "StadiaPass.Roles.Manage",
        "description": "Manage roles and the permissions bound to them"
      },
      {
        "name": "StadiaPass.Users",
        "description": "User module"
      },
      {
        "name": "StadiaPass.Users.View",
        "description": "Read users"
      },
      {
        "name": "StadiaPass.Users.Create",
        "description": "Create a user"
      },
      {
        "name": "StadiaPass.Users.Manage",
        "description": "Manage users and their role assignments"
      },
      {
        "name": "Administrator",
        "description": "Full access, including the identity portal",
        "composite": true,
        "composites": {
          "realm": [
            "StadiaPass.Venues.View",
            "StadiaPass.Venues.Create",
            "StadiaPass.Matches.View",
            "StadiaPass.Matches.Create",
            "StadiaPass.Matches.Cancel",
            "StadiaPass.Analytics.ViewRevenue",
            "StadiaPass.Tickets.View",
            "StadiaPass.Tickets.Reserve",
            "StadiaPass.Tickets.Purchase",
            "StadiaPass.Tickets.Cancel",
            "StadiaPass.Tickets.ViewAll",
            "StadiaPass.Roles.View",
            "StadiaPass.Roles.Create",
            "StadiaPass.Roles.Manage",
            "StadiaPass.Users.View",
            "StadiaPass.Users.Create",
            "StadiaPass.Users.Manage",
            "StadiaPass.Venues.Update",
            "StadiaPass.Venues.Delete",
            "StadiaPass.Categories.View",
            "StadiaPass.Categories.Create",
            "StadiaPass.Categories.Update",
            "StadiaPass.Categories.Delete"
          ]
        }
      },
      {
        "name": "MatchManager",
        "description": "Defines venues and opens matches for sale",
        "composite": true,
        "composites": {
          "realm": [
            "StadiaPass.Venues.View",
            "StadiaPass.Venues.Create",
            "StadiaPass.Matches.View",
            "StadiaPass.Matches.Create",
            "StadiaPass.Tickets.View",
            "StadiaPass.Venues.Update",
            "StadiaPass.Venues.Delete",
            "StadiaPass.Categories.View",
            "StadiaPass.Categories.Create",
            "StadiaPass.Categories.Update",
            "StadiaPass.Categories.Delete"
          ]
        }
      },
      {
        "name": "BoxOffice",
        "description": "Sells and cancels tickets at the gate",
        "composite": true,
        "composites": {
          "realm": [
            "StadiaPass.Matches.View",
            "StadiaPass.Tickets.View",
            "StadiaPass.Tickets.Reserve",
            "StadiaPass.Tickets.Purchase",
            "StadiaPass.Tickets.Cancel",
            "StadiaPass.Tickets.ViewAll"
          ]
        }
      },
      {
        "name": "Customer",
        "description": "Browses matches, holds a seat and buys it",
        "composite": true,
        "composites": {
          "realm": [
            "StadiaPass.Matches.View",
            "StadiaPass.Tickets.View",
            "StadiaPass.Tickets.Reserve",
            "StadiaPass.Tickets.Purchase"
          ]
        }
      },
      {
        "name": "Viewer",
        "description": "Read only access to matches and tickets",
        "composite": true,
        "composites": {
          "realm": [
            "StadiaPass.Matches.View",
            "StadiaPass.Tickets.View"
          ]
        }
      },
      {
        "name": "StadiaPass.Venues.Update",
        "description": "Update a venue"
      },
      {
        "name": "StadiaPass.Venues.Delete",
        "description": "Delete a venue"
      },
      {
        "name": "StadiaPass.Categories",
        "description": "Category module"
      },
      {
        "name": "StadiaPass.Categories.View",
        "description": "Read sport categories"
      },
      {
        "name": "StadiaPass.Categories.Create",
        "description": "Add a sport category"
      },
      {
        "name": "StadiaPass.Categories.Update",
        "description": "Update a sport category"
      },
      {
        "name": "StadiaPass.Categories.Delete",
        "description": "Delete a sport category"
      }
    ]
  },
  "clients": [
    {
      "clientId": "stadiapass-api",
      "name": "StadiaPass API",
      "description": "Resource server. Validates tokens, never initiates a flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "stadiapass-scalar",
      "name": "StadiaPass Scalar reference",
      "description": "Public client used by the Scalar OpenAPI UI (authorization code + PKCE).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5042/*",
        "https://localhost:7147/*"
      ],
      "webOrigins": [
        "http://localhost:5042",
        "https://localhost:7147"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "stadiapass-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "stadiapass-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "stadiapass-mvc",
      "name": "StadiaPass MVC",
      "description": "Confidential client for the Razor front end. Direct access grants are enabled for local endpoint testing only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "stadiapass-mvc-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost:7064/*",
        "http://localhost:5230/*"
      ],
      "webOrigins": [
        "https://localhost:7064",
        "http://localhost:5230"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "stadiapass-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "stadiapass-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles in id token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "stadiapass-admin-api",
      "name": "StadiaPass Admin API broker",
      "description": "Service account the WebAPI uses to call the Keycloak Admin REST API. Scoped to this realm only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "stadiapass-admin-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "stadiapass-mcp",
      "name": "StadiaPass MCP server",
      "description": "Service account the MCP server uses for the analytics tool. No login flow: nobody signs in as this client, it asks for its own token and holds one permission.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "stadiapass-mcp-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "stadiapass-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "stadiapass-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
