{
  "realm": "stadiapass",
  "displayName": "StadiaPass",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "StadiaPass.Venues", "description": "Venue module" },
      { "name": "StadiaPass.Venues.View", "description": "Read venues and their seating plans" },
      { "name": "StadiaPass.Venues.Create", "description": "Define a venue seating plan" },
      { "name": "StadiaPass.Matches", "description": "Match module" },
      { "name": "StadiaPass.Matches.View", "description": "Browse matches and seat maps" },
      { "name": "StadiaPass.Matches.Create", "description": "Create a match and materialise its seats" },
      { "name": "StadiaPass.Matches.Postpone", "description": "Postpone a match" },
      { "name": "StadiaPass.Tickets", "description": "Ticket module" },
      { "name": "StadiaPass.Tickets.View", "description": "Read own tickets" },
      { "name": "StadiaPass.Tickets.Reserve", "description": "Hold a seat on the seat map" },
      { "name": "StadiaPass.Tickets.Purchase", "description": "Turn a held seat into a ticket" },
      { "name": "StadiaPass.Tickets.Cancel", "description": "Cancel an issued ticket" }
    ]
  },
  "clients": [
    {
      "clientId": "stadiapass-api",
      "name": "StadiaPass API",
      "description": "Resource server. Validates tokens, never initiates a flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "stadiapass-scalar",
      "name": "StadiaPass Scalar reference",
      "description": "Public client used by the Scalar OpenAPI UI (authorization code + PKCE).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5042/*", "https://localhost:7147/*"],
      "webOrigins": ["http://localhost:5042", "https://localhost:7147"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "stadiapass-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "stadiapass-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "stadiapass-mvc",
      "name": "StadiaPass MVC",
      "description": "Confidential client for the Razor front end. Direct access grants are enabled for local endpoint testing only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "stadiapass-mvc-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://localhost:7064/*", "http://localhost:5230/*"],
      "webOrigins": ["https://localhost:7064", "http://localhost:5230"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "stadiapass-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "stadiapass-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles in id token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "mudur",
      "firstName": "Merve",
      "lastName": "Mudur",
      "email": "mudur@stadiapass.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "mudur", "temporary": false }],
      "realmRoles": [
        "StadiaPass.Venues.View",
        "StadiaPass.Venues.Create",
        "StadiaPass.Matches.View",
        "StadiaPass.Matches.Create",
        "StadiaPass.Matches.Postpone",
        "StadiaPass.Tickets.View",
        "StadiaPass.Tickets.Reserve",
        "StadiaPass.Tickets.Purchase",
        "StadiaPass.Tickets.Cancel"
      ]
    },
    {
      "username": "gise",
      "firstName": "Gokhan",
      "lastName": "Gise",
      "email": "gise@stadiapass.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "gise", "temporary": false }],
      "realmRoles": [
        "StadiaPass.Venues.View",
        "StadiaPass.Matches.View",
        "StadiaPass.Tickets.View",
        "StadiaPass.Tickets.Reserve",
        "StadiaPass.Tickets.Purchase",
        "StadiaPass.Tickets.Cancel"
      ]
    },
    {
      "username": "musteri",
      "firstName": "Mert",
      "lastName": "Musteri",
      "email": "musteri@stadiapass.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "musteri", "temporary": false }],
      "realmRoles": [
        "StadiaPass.Matches.View",
        "StadiaPass.Tickets.View",
        "StadiaPass.Tickets.Reserve",
        "StadiaPass.Tickets.Purchase"
      ]
    },
    {
      "username": "seyirci",
      "firstName": "Selim",
      "lastName": "Seyirci",
      "email": "seyirci@stadiapass.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "seyirci", "temporary": false }],
      "realmRoles": ["StadiaPass.Matches.View", "StadiaPass.Tickets.View"]
    }
  ]
}
